# === SUPABASE ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# === JWT ===
JWT_SECRET=replace-with-a-long-random-secret

# === TEACHER REGISTRATION SECRET ===
# Dùng mã này để đăng ký tài khoản giáo viên
TEACHER_SECRET=replace-with-a-private-registration-secret

# === AI ASSIGNMENT AUTHORING (SERVER ONLY) ===
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
AI_REQUEST_TIMEOUT_MS=45000
AI_ASSIGNMENT_MAX_INPUT_CHARS=12000

# === CORS ===
# Dev:
CORS_ORIGIN=http://localhost:5173
# Production (deploy): set env var trên hosting dashboard

# === SERVER ===
PORT=3001
NODE_ENV=development
