# === SUPABASE ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# === JWT ===
JWT_SECRET=replace-with-a-long-random-secret

# === TEACHER REGISTRATION SECRET ===
# Dùng mã này để đăng ký tài khoản giáo viên
TEACHER_SECRET=replace-with-a-private-registration-secret

# === AI ASSIGNMENT AUTHORING (SERVER ONLY) ===
OPENROUTER_API_KEY=   # Dùng cho chat + embedding + vision (qwen-vl-plus:free)
OPENROUTER_MODEL=
GEMINI_API_KEY=       # Tuỳ chọn — dùng cho embedding (text-embedding-004) nếu có
GEMINI_MODEL=
BRAVE_SEARCH_API_KEY= # Tuỳ chọn — dùng cho web search (Supabase Edge Function)
AI_REQUEST_TIMEOUT_MS=45000
AI_ASSIGNMENT_MAX_INPUT_CHARS=12000

# === CORS ===
# Dev:
CORS_ORIGIN=http://localhost:5173
# Production (deploy): set env var trên hosting dashboard

# === SERVER ===
PORT=3001
NODE_ENV=development

# === CLOUDFLARE R2 ===
R2_ACCOUNT_ID=f7e7ec45d6c0791d6225b752fb167b3f
R2_BUCKET_NAME=lms-submissions
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
